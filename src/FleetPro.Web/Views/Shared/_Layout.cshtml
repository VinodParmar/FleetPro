@inject Microsoft.Extensions.Configuration.IConfiguration _cfg
<!DOCTYPE html>
<html lang="@ViewData["Lang"]">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] ?? "FleetPro") | FleetPro</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/4.6.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/admin-lte/3.2.0/css/adminlte.min.css">
    <style>
        .brand-link { background: #1a2980 !important; }
        .brand-text { color:#fff!important;font-weight:700; }
        .main-sidebar { background: #1e2a4a !important; }
        .sidebar .nav-sidebar .nav-link { color:#c9d1e0 !important; }
        .sidebar .nav-sidebar .nav-link:hover, .sidebar .nav-sidebar .nav-link.active { background:rgba(255,255,255,0.1)!important;color:#fff!important; }
        .action-btn { white-space: nowrap; }
        .table thead th { background: #f8f9fa; font-size: 12px; font-weight:600; text-transform:uppercase; letter-spacing:.5px; }
        .expiry-ok  { color:#00a65a; }
        .expiry-warn{ color:#f39c12; }
        .expiry-bad { color:#dd4b39; font-weight:600; }
        .sidebar-dark-primary .nav-sidebar>.nav-item>.nav-link.active { background:rgba(255,255,255,.15)!important; }
        .badge-purple { background-color: #7b2ff7; color: #fff; }
        body { font-family:'Segoe UI',sans-serif; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

    <!-- ── NAVBAR ─────────────────────────── -->
    <nav class="main-header navbar navbar-expand navbar-white navbar-light">
        <ul class="navbar-nav">
            <li class="nav-item"><a class="nav-link" data-widget="pushmenu" href="#"><i class="fas fa-bars"></i></a></li>
            <li class="nav-item d-none d-sm-inline-block">
                <a asp-controller="Dashboard" asp-action="Index" class="nav-link">@L["Home"]</a>
            </li>
        </ul>

        <ul class="navbar-nav ml-auto">
            <!-- Language Toggle -->
            <li class="nav-item mr-2 d-flex align-items-center" style="gap:4px;">
                <a href="?lang=hi" class="btn btn-sm @(ViewData["Lang"]?.ToString()=="hi" ? "btn-primary" : "btn-outline-secondary") py-1" style="font-size:12px;">हि</a>
                <a href="?lang=en" class="btn btn-sm @(ViewData["Lang"]?.ToString()!="hi" ? "btn-primary" : "btn-outline-secondary") py-1" style="font-size:12px;">En</a>
            </li>

            <!-- Alerts Bell -->
            <li class="nav-item dropdown">
                <a class="nav-link" data-toggle="dropdown" href="#">
                    <i class="far fa-bell"></i>
                    @{
                        var alertCount = ViewBag.AlertCount as int? ?? 0;
                        if (alertCount > 0) { <span class="badge badge-danger navbar-badge">@alertCount</span> }
                    }
                </a>
                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right">
                    <span class="dropdown-item dropdown-header">@alertCount @L["Alerts"]</span>
                    <div class="dropdown-divider"></div>
                    <a asp-controller="Alert" asp-action="Index" class="dropdown-item dropdown-footer">@L["View All Alerts"]</a>
                </div>
            </li>

            <!-- User Menu -->
            <li class="nav-item dropdown">
                <a class="nav-link" data-toggle="dropdown" href="#">
                    <span class="d-none d-md-inline" style="font-size:13px;">@User.Identity?.Name</span>
                    <i class="fas fa-user-circle ml-1"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-right">
                    <span class="dropdown-item-text text-muted" style="font-size:12px;">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</span>
                    <div class="dropdown-divider"></div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item"><i class="fas fa-sign-out-alt mr-2"></i>@L["Logout"]</button>
                    </form>
                </div>
            </li>
        </ul>
    </nav>

    <!-- ── SIDEBAR ─────────────────────────── -->
    <aside class="main-sidebar sidebar-dark-primary elevation-4">
        <a asp-controller="Dashboard" asp-action="Index" class="brand-link">
            <i class="fas fa-truck-moving mx-3" style="color:#26d0ce;font-size:20px;"></i>
            <span class="brand-text">FleetPro</span>
        </a>
        <div class="sidebar">
            <div class="user-panel mt-3 pb-3 mb-3 d-flex">
                <div class="image">
                    <span style="width:34px;height:34px;border-radius:50%;background:#7b2ff7;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:13px;">
                        @(User.Identity?.Name?.Substring(0,1).ToUpper())
                    </span>
                </div>
                <div class="info ml-2">
                    <a href="#" class="d-block" style="color:#fff;font-size:13px;">@User.Identity?.Name</a>
                    <small style="color:#aaa;font-size:10px;">
                        @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                    </small>
                </div>
            </div>
            @await Html.PartialAsync("_Sidebar")
        </div>
    </aside>

    <!-- ── CONTENT WRAPPER ─────────────────── -->
    <div class="content-wrapper">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show m-3 mb-0" role="alert">
                <i class="fas fa-check-circle mr-2"></i>@TempData["Success"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show m-3 mb-0" role="alert">
                <i class="fas fa-exclamation-circle mr-2"></i>@TempData["Error"]
                <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            </div>
        }
        @RenderBody()
    </div>

    <footer class="main-footer text-sm">
        <strong>© @DateTime.Now.Year FleetPro</strong> — Multi-Company Fleet Management
        <div class="float-right d-none d-sm-inline-block"><b>v2.5.0</b> · ASP.NET Core 10 MVC</div>
    </footer>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/4.6.2/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/admin-lte/3.2.0/js/adminlte.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
<script>
    // Auto-dismiss alerts after 4s
    setTimeout(() => { $('.alert-dismissible').alert('close'); }, 4000);

    // Confirm delete
    $('[data-confirm]').on('click', function (e) {
        if (!confirm($(this).data('confirm'))) e.preventDefault();
    });
</script>
@await RenderSectionAsync("Scripts", required: false)

@if (TempData["AccessDenied"] != null)
{
    var deniedAction   = TempData["AccessDeniedAction"]?.ToString() ?? "";
    var deniedResource = TempData["AccessDeniedResource"]?.ToString() ?? "";

    <!-- Access Denied Modal -->
    <div class="modal fade" id="accessDeniedModal" tabindex="-1" role="dialog" aria-labelledby="accessDeniedModalLabel" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="accessDeniedModalLabel">
                        <i class="fas fa-ban mr-2"></i>Access Denied
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body text-center py-4">
                    <i class="fas fa-lock fa-3x text-danger mb-3 d-block"></i>
                    @if (!string.IsNullOrEmpty(deniedAction) && !string.IsNullOrEmpty(deniedResource))
                    {
                        <div class="mb-3">
                            <span class="badge badge-danger px-3 py-2" style="font-size:14px;">
                                <i class="fas fa-shield-alt mr-1"></i>@deniedAction &nbsp;<strong>@deniedResource</strong>
                            </span>
                        </div>
                    }
                    <p class="mb-1">@TempData["AccessDenied"]</p>
                    <small class="text-muted">Contact your administrator if you need access.</small>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <script>
        $(function () { $('#accessDeniedModal').modal('show'); });
    </script>
}

@if (User.Identity?.IsAuthenticated == true)
{
    var idleMinutes = _cfg.GetValue<int>("AppSettings:IdleLockTimeoutMinutes", 1);
    var userName    = User.Identity.Name ?? "";
    var userInitial = userName.Length > 0 ? userName[0].ToString().ToUpper() : "?";
    var userEmail   = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";

    <!-- ── LOCK SCREEN OVERLAY ───────────────────── -->
    <div id="lockScreen" style="display:none;position:fixed;inset:0;z-index:99999;background:linear-gradient(135deg,#1a2980 0%,#26d0ce 100%);align-items:center;justify-content:center;">
        <div style="width:100%;max-width:380px;padding:16px;">
            <div class="card shadow-lg" style="border-radius:16px;overflow:hidden;">
                <div class="card-body text-center p-4">
                    <div style="width:72px;height:72px;border-radius:50%;background:#7b2ff7;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:28px;font-weight:700;margin-bottom:12px;">
                        @userInitial
                    </div>
                    <h5 class="mb-0 font-weight-bold">@userName</h5>
                    <small class="text-muted">@userEmail</small>
                    <p class="mt-3 mb-3 text-muted" style="font-size:13px;"><i class="fas fa-lock mr-1"></i>Session locked due to inactivity</p>

                    <div class="input-group mb-3">
                        <input type="password" id="lockPassword" class="form-control" placeholder="Enter your password to unlock"
                               style="border-radius:8px 0 0 8px;" autocomplete="current-password">
                        <div class="input-group-append">
                            <button id="lockToggleBtn" class="btn btn-outline-secondary" type="button" tabindex="-1"
                                    onclick="var i=document.getElementById('lockPassword');i.type=i.type==='password'?'text':'password';">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    <div id="lockError" class="alert alert-danger py-1 small mb-2" style="display:none;">Incorrect password. Please try again.</div>

                    <button id="unlockBtn" class="btn btn-primary btn-block mb-2" style="border-radius:8px;">
                        <i class="fas fa-unlock mr-1"></i>Unlock
                    </button>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link btn-sm text-muted">Sign out instead</button>
                    </form>
                </div>
            </div>
            <p class="text-center text-white mt-3" style="font-size:11px;opacity:.7;">FleetPro · Session Protection</p>
        </div>
    </div>

    <script>
    (function () {
        var IDLE_MS = @(idleMinutes * 60 * 1000);
        var timer, locked = false;
        var overlay = document.getElementById('lockScreen');
        var pwdInput = document.getElementById('lockPassword');
        var errMsg   = document.getElementById('lockError');
        var token    = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

        function lock() {
            if (locked) return;
            locked = true;
            overlay.style.display = 'flex';
            pwdInput.value = '';
            errMsg.style.display = 'none';
            setTimeout(function () { pwdInput.focus(); }, 100);
        }

        function resetTimer() {
            if (locked) return;
            clearTimeout(timer);
            timer = setTimeout(lock, IDLE_MS);
        }

        // Listen for any user activity
        ['mousemove','keydown','mousedown','touchstart','scroll','click'].forEach(function(evt) {
            document.addEventListener(evt, resetTimer, { passive: true });
        });

        // Unlock handler
        document.getElementById('unlockBtn').addEventListener('click', tryUnlock);
        pwdInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') tryUnlock(); });

        function tryUnlock() {
            var btn = document.getElementById('unlockBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i>Checking…';
            errMsg.style.display = 'none';

            // Get a fresh antiforgery token from the hidden form inside the overlay
            var formToken = overlay.querySelector('input[name="__RequestVerificationToken"]')?.value ?? token;

            fetch('@Url.Action("Unlock", "Account")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': formToken },
                body: 'password=' + encodeURIComponent(pwdInput.value) + '&__RequestVerificationToken=' + encodeURIComponent(formToken)
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    locked = false;
                    overlay.style.display = 'none';
                    pwdInput.value = '';
                    resetTimer();
                } else {
                    errMsg.style.display = 'block';
                    pwdInput.value = '';
                    pwdInput.focus();
                }
            })
            .catch(function() { errMsg.style.display = 'block'; })
            .finally(function() {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-unlock mr-1"></i>Unlock';
            });
        }

        resetTimer(); // start the idle timer on page load
    })();
    </script>
}
</body>
</html>