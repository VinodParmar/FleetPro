@inject FleetPro.Services.IMenuService _menuService
@{
    var ctrl  = ViewContext.RouteData.Values["controller"]?.ToString();
    var menus = await _menuService.GetMenuAsync();
}
<nav class="mt-2">
    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

        @foreach (var item in menus)
        {
            var hasChildren = item.Children.Any();
            var isActive    = ctrl == item.Controller || item.Children.Any(c => c.Controller == ctrl);

            @if (!hasChildren)
            {
                <li class="nav-item">
                    <a asp-controller="@item.Controller" asp-action="@item.Action"
                       class="nav-link @(isActive ? "active" : "")">
                        <i class="nav-icon @item.Icon"></i>
                        <p>
                            @L[item.Title]
                            @if (item.Controller == "Alert")
                            {
                                <span class="badge badge-danger ml-2">@(ViewBag.AlertCount ?? "")</span>
                            }
                        </p>
                    </a>
                </li>
            }
            else
            {
                <li class="nav-item @(isActive ? "menu-open" : "")">
                    <a href="#" class="nav-link @(isActive ? "active" : "")">
                        <i class="nav-icon @item.Icon"></i>
                        <p>@L[item.Title] <i class="right fas fa-angle-left"></i></p>
                    </a>
                    <ul class="nav nav-treeview">
                        @foreach (var child in item.Children)
                        {
                            <li class="nav-item">
                                <a asp-controller="@child.Controller" asp-action="@child.Action" class="nav-link">
                                    <i class="@child.Icon nav-icon"></i><p>@L[child.Title]</p>
                                </a>
                            </li>
                        }
                    </ul>
                </li>
            }
        }

    </ul>
</nav>
