@* ══════════════════ Views/Tenant/Index.cshtml ══════════════════ *@
@model List<FleetPro.Models.ViewModels.TenantViewModel>
@{
    ViewData["Title"] = L["Companies"].Value;
}

<div class="content-header"><div class="container-fluid">
    <div class="row mb-2">
        <div class="col-sm-6">
            <h1 class="m-0">@L["Companies"]
                <a asp-action="Create" class="btn btn-primary btn-sm ml-2"><i class="fas fa-plus mr-1"></i>@L["Add Company"]</a>
            </h1>
        </div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i></a></li>
                <li class="breadcrumb-item active">@L["Companies"]</li>
            </ol>
        </div>
    </div>
</div></div>

<section class="content"><div class="container-fluid">

    <div class="row mb-3">
        <div class="col-md-3"><div class="info-box mb-0"><span class="info-box-icon bg-info"><i class="fas fa-building"></i></span><div class="info-box-content"><span class="info-box-text">@L["Total"]</span><span class="info-box-number">@Model.Count</span></div></div></div>
        <div class="col-md-3"><div class="info-box mb-0"><span class="info-box-icon bg-success"><i class="fas fa-check"></i></span><div class="info-box-content"><span class="info-box-text">@L["Active"]</span><span class="info-box-number">@Model.Count(t => t.Status == FleetPro.Models.Entities.TenantStatus.Active)</span></div></div></div>
        <div class="col-md-3"><div class="info-box mb-0"><span class="info-box-icon bg-warning"><i class="fas fa-clock"></i></span><div class="info-box-content"><span class="info-box-text">@L["Trial"]</span><span class="info-box-number">@Model.Count(t => t.Status == FleetPro.Models.Entities.TenantStatus.Trial)</span></div></div></div>
        <div class="col-md-3"><div class="info-box mb-0"><span class="info-box-icon bg-secondary"><i class="fas fa-pause"></i></span><div class="info-box-content"><span class="info-box-text">@L["Inactive"]</span><span class="info-box-number">@Model.Count(t => t.Status == FleetPro.Models.Entities.TenantStatus.Inactive)</span></div></div></div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:110px;">@L["Actions"]</th>
                        <th>@L["Company"]</th><th>@L["Subdomain"]</th><th>@L["Contact"]</th><th>@L["Plan"]</th>
                        <th>@L["Trucks"]</th><th>@L["Drivers"]</th><th>@L["Users"]</th><th>@L["Status"]</th><th>@L["City"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="action-btn">
                                <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-xs btn-warning" title="Edit"><i class="fas fa-edit"></i></a>
                                <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-xs btn-danger" data-confirm="@L["Delete company {0}? This cannot be undone.", t.CompanyName]" title="Delete"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span style="width:32px;height:32px;border-radius:50%;background:#1a2980;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:11px;margin-right:8px;flex-shrink:0;">
                                        @(string.Concat(t.CompanyName.Split(' ').Take(2).Select(w => w[0])))
                                    </span>
                                    <div>
                                        <strong>@t.CompanyName</strong>
                                        @if (!string.IsNullOrEmpty(t.GstNumber))
                                        { <br><small class="text-muted">GST: @t.GstNumber</small> }
                                    </div>
                                </div>
                            </td>
                            <td><small class="text-info">@(t.Subdomain).fleetpro.in</small></td>
                            <td>
                                <strong>@t.ContactPerson</strong>
                                @if (!string.IsNullOrEmpty(t.Email))
                                { <br><small class="text-muted">@t.Email</small> }
                            </td>
                            <td>
                                @switch (t.Plan)
                                {
                                    case FleetPro.Models.Entities.TenantPlan.Starter: <span class="badge badge-secondary">Starter</span> break;
                                    case FleetPro.Models.Entities.TenantPlan.Business:<span class="badge badge-info">Business</span> break;
                                    case FleetPro.Models.Entities.TenantPlan.Premium: <span class="badge badge-warning">Premium</span> break;
                                }
                            </td>
                            <td>@t.TruckCount / @t.MaxTrucks</td>
                            <td>@t.DriverCount</td>
                            <td>@t.UserCount / @t.MaxUsers</td>
                            <td>
                                @switch (t.Status)
                                {
                                    case FleetPro.Models.Entities.TenantStatus.Active:   <span class="badge badge-success">@L["Active"]</span>   break;
                                    case FleetPro.Models.Entities.TenantStatus.Trial:    <span class="badge badge-warning">@L["Trial"]</span>    break;
                                    case FleetPro.Models.Entities.TenantStatus.Inactive: <span class="badge badge-secondary">@L["Inactive"]</span> break;
                                    case FleetPro.Models.Entities.TenantStatus.Suspended:<span class="badge badge-danger">@L["Suspended"]</span> break;
                                }
                            </td>
                            <td>@t.City, @t.State</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    { <tr><td colspan="10" class="text-center text-muted py-4">@L["No companies found."]</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div></section>
