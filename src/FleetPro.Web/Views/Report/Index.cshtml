@* ══════════════════ Views/Report/Index.cshtml ══════════════════ *@
@model FleetPro.Models.ViewModels.ReportFilterViewModel
@{
    ViewData["Title"] = L["Reports"].Value;
}

<div class="content-header"><div class="container-fluid">
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">@L["Reports"]</h1></div>
    </div>
</div></div>

<section class="content"><div class="container-fluid">
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-primary text-white"><h3 class="card-title"><i class="fas fa-chart-line mr-2"></i>@L["Profit & Loss Report"]</h3></div>
                <div class="card-body">
                    <form asp-action="PL" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label>@L["From Date"]</label>
                            <input asp-for="FromDate" type="date" class="form-control" value="@DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd")">
                        </div>
                        <div class="form-group">
                            <label>@L["To Date"]</label>
                            <input asp-for="ToDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                        </div>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="form-group">
                                <label>@L["Tenant"]</label>
                                <select asp-for="TenantId" class="form-control">
                                    <option value="">@L["All Tenants"]</option>
                                </select>
                            </div>
                        }
                        <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-file-alt mr-1"></i>@L["Generate P&L Report"]</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-success text-white"><h3 class="card-title"><i class="fas fa-file-excel mr-2"></i>@L["Trip Report (Excel)"]</h3></div>
                <div class="card-body">
                    <form asp-action="ExportTripsExcel" method="get">
                        <div class="form-group">
                            <label>@L["From Date"]</label>
                            <input name="from" type="date" class="form-control" value="@DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd")">
                        </div>
                        <div class="form-group">
                            <label>@L["To Date"]</label>
                            <input name="to" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="form-group">
                            <label>@L["Status"]</label>
                            <select name="status" class="form-control">
                                <option value="">@L["All"]</option>
                                @foreach (var s in Enum.GetValues<FleetPro.Models.Entities.TripStatus>())
                                { <option value="@s">@s</option> }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success btn-block"><i class="fas fa-download mr-1"></i>@L["Download Excel"]</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-danger text-white"><h3 class="card-title"><i class="fas fa-file-pdf mr-2"></i>@L["Expense Report"]</h3></div>
                <div class="card-body">
                    <div class="form-group">
                        <label>@L["From Date"]</label>
                        <input type="date" class="form-control" value="@DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd")">
                    </div>
                    <div class="form-group">
                        <label>@L["Category"]</label>
                        <select class="form-control">
                            <option value="">@L["All Categories"]</option>
                            @foreach (var c in Enum.GetValues<FleetPro.Models.Entities.ExpenseCategory>())
                            { <option value="@c">@c</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>@L["Format"]</label>
                        <select class="form-control"><option>Excel (.xlsx)</option><option>PDF</option></select>
                    </div>
                    <button class="btn btn-danger btn-block" disabled><i class="fas fa-download mr-1"></i>@L["Download (Coming Soon)"]</button>
                </div>
            </div>
        </div>
    </div>
</div></section>
