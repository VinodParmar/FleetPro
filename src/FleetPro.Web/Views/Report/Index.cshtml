@* ══════════════════ Views/Report/Index.cshtml ══════════════════ *@
@model FleetPro.Models.ViewModels.ReportFilterViewModel
@{
    ViewData["Title"] = "Reports";
    bool isHi = ViewData["Lang"]?.ToString() == "hi";
}

<div class="content-header"><div class="container-fluid">
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">@(isHi ? "रिपोर्ट" : "Reports")</h1></div>
    </div>
</div></div>

<section class="content"><div class="container-fluid">
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-primary text-white"><h3 class="card-title"><i class="fas fa-chart-line mr-2"></i>@(isHi ? "लाभ और हानि रिपोर्ट" : "Profit & Loss Report")</h3></div>
                <div class="card-body">
                    <form asp-action="PL" method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label>@(isHi ? "से तारीख" : "From Date")</label>
                            <input asp-for="FromDate" type="date" class="form-control" value="@DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd")">
                        </div>
                        <div class="form-group">
                            <label>@(isHi ? "तक तारीख" : "To Date")</label>
                            <input asp-for="ToDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                        </div>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <div class="form-group">
                                <label>@(isHi ? "किरायेदार" : "Tenant")</label>
                                <select asp-for="TenantId" class="form-control">
                                    <option value="">@(isHi ? "सभी किरायेदार" : "All Tenants")</option>
                                </select>
                            </div>
                        }
                        <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-file-alt mr-1"></i>@(isHi ? "P&L रिपोर्ट तैयार करें" : "Generate P&L Report")</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-success text-white"><h3 class="card-title"><i class="fas fa-file-excel mr-2"></i>@(isHi ? "यात्रा रिपोर्ट (Excel)" : "Trip Report (Excel)")</h3></div>
                <div class="card-body">
                    <form asp-action="ExportTripsExcel" method="get">
                        <div class="form-group">
                            <label>@(isHi ? "से तारीख" : "From Date")</label>
                            <input name="from" type="date" class="form-control" value="@DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd")">
                        </div>
                        <div class="form-group">
                            <label>@(isHi ? "तक तारीख" : "To Date")</label>
                            <input name="to" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="form-group">
                            <label>@(isHi ? "स्थिति" : "Status")</label>
                            <select name="status" class="form-control">
                                <option value="">@(isHi ? "सभी" : "All")</option>
                                @foreach (var s in Enum.GetValues<FleetPro.Models.Entities.TripStatus>())
                                { <option value="@s">@s</option> }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success btn-block"><i class="fas fa-download mr-1"></i>@(isHi ? "Excel डाउनलोड करें" : "Download Excel")</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-danger text-white"><h3 class="card-title"><i class="fas fa-file-pdf mr-2"></i>@(isHi ? "व्यय रिपोर्ट" : "Expense Report")</h3></div>
                <div class="card-body">
                    <div class="form-group">
                        <label>@(isHi ? "से तारीख" : "From Date")</label>
                        <input type="date" class="form-control" value="@DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd")">
                    </div>
                    <div class="form-group">
                        <label>@(isHi ? "श्रेणी" : "Category")</label>
                        <select class="form-control">
                            <option value="">@(isHi ? "सभी श्रेणियां" : "All Categories")</option>
                            @foreach (var c in Enum.GetValues<FleetPro.Models.Entities.ExpenseCategory>())
                            { <option value="@c">@c</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>@(isHi ? "प्रारूप" : "Format")</label>
                        <select class="form-control"><option>Excel (.xlsx)</option><option>PDF</option></select>
                    </div>
                    <button class="btn btn-danger btn-block" disabled><i class="fas fa-download mr-1"></i>@(isHi ? "डाउनलोड (शीघ्र आ रहा है)" : "Download (Coming Soon)")</button>
                </div>
            </div>
        </div>
    </div>
</div></section>
