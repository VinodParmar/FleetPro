@* ══════════════════ Views/Driver/Index.cshtml ══════════════════ *@
@model List<FleetPro.Models.Entities.Driver>
@{
    ViewData["Title"] = L["Drivers"].Value;
    string ExpiryClass(DateTime? d) => d == null ? "" : (d < DateTime.Today ? "expiry-bad" : d < DateTime.Today.AddDays(30) ? "expiry-warn" : "expiry-ok");
}

<div class="content-header"><div class="container-fluid">
    <div class="row mb-2">
        <div class="col-sm-6">
            <h1 class="m-0">@L["Drivers"]
                <a asp-action="Create" class="btn btn-primary btn-sm ml-2"><i class="fas fa-plus mr-1"></i>@L["Add Driver"]</a>
            </h1>
        </div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i></a></li>
                <li class="breadcrumb-item active">@L["Drivers"]</li>
            </ol>
        </div>
    </div>
</div></div>

<section class="content"><div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <form method="get" class="form-inline" style="gap:6px;">
                <select name="status" class="form-control form-control-sm" onchange="this.form.submit()">
                    <option value="">@L["All Status"]</option>
                    @foreach (var s in Enum.GetValues<FleetPro.Models.Entities.DriverStatus>())
                    { <option value="@s" selected="@(Context.Request.Query["status"] == s.ToString() ? "selected" : null)">@s</option> }
                </select>
                <input name="search" value="@Context.Request.Query["search"]" class="form-control form-control-sm" placeholder="@L["Name / License #"]">
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fas fa-search"></i></button>
            </form>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:100px;">@L["Actions"]</th>
                        <th>@L["Name"]</th><th>@L["Phone"]</th>
                        @if (User.IsInRole("SuperAdmin")) { <th>@L["Company"]</th> }
                        <th>@L["License #"]</th><th>@L["License Type"]</th><th>@L["License Expiry"]</th><th>@L["Salary"]</th><th>@L["Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td class="action-btn">
                                <a asp-action="Edit" asp-route-eid="@Ids.Protect(d.Id)" class="btn btn-xs btn-warning" title="Edit"><i class="fas fa-edit"></i></a>
                                <form asp-action="Delete" asp-route-eid="@Ids.Protect(d.Id)" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-xs btn-danger" data-confirm="@L["Delete driver {0}?", d.FullName]" title="Delete"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span style="width:32px;height:32px;border-radius:50%;background:#1a2980;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:700;margin-right:8px;">
                                        @d.FullName.Substring(0, 1)
                                    </span>
                                    <strong>@d.FullName</strong>
                                </div>
                            </td>
                            <td>@d.Phone</td>
                            @if (User.IsInRole("SuperAdmin")) { <td>@d.Tenant?.CompanyName</td> }
                            <td><code>@d.LicenseNumber</code></td>
                            <td>@d.LicenseType</td>
                            <td class="@ExpiryClass(d.LicenseExpiry)">
                                <i class="fas @(d.LicenseExpiry < DateTime.Today.AddDays(30) ? "fa-exclamation-triangle" : "fa-check-circle") mr-1"></i>
                                @(d.LicenseExpiry?.ToString("dd MMM yyyy") ?? "—")
                                @if (d.LicenseExpiry.HasValue)
                                {
                                    var days = (d.LicenseExpiry.Value - DateTime.Today).Days;
                                    <small>(@(days < 0 ? L["EXPIRED"].Value : days + "d"))</small>
                                }
                            </td>
                            <td>@(d.MonthlySalary.HasValue ? "₹" + d.MonthlySalary.Value.ToString("N0") : "—")</td>
                            <td>
                                @switch (d.Status)
                                {
                                    case FleetPro.Models.Entities.DriverStatus.Active:  <span class="badge badge-success">@L["Active"]</span>  break;
                                    case FleetPro.Models.Entities.DriverStatus.OnLeave: <span class="badge badge-warning">@L["On Leave"]</span> break;
                                    case FleetPro.Models.Entities.DriverStatus.Inactive:<span class="badge badge-secondary">@L["Inactive"]</span> break;
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    { <tr><td colspan="9" class="text-center text-muted py-4">@L["No drivers found."]</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div></section>
