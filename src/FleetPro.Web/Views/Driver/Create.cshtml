@* ══════════════════ Views/Driver/Create.cshtml ══════════════════ *@
@model FleetPro.Models.ViewModels.DriverViewModel
@{
    bool isCreate = Model.Id == 0;
    ViewData["Title"] = isCreate ? L["Add Driver"].Value : L["Edit Driver"].Value;
}

<div class="content-header"><div class="container-fluid">
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">@ViewData["Title"]</h1></div>
        <div class="col-sm-6"><ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i></a></li>
            <li class="breadcrumb-item"><a asp-action="Index">@L["Drivers"]</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol></div>
    </div>
</div></div>

<section class="content"><div class="container-fluid">
<form asp-action="@(isCreate ? "Create" : "Edit")" asp-route-eid="@Ids.Protect(Model.Id)" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-warning"><h3 class="card-title"><i class="fas fa-user-tie mr-2"></i>@L["Driver Profile"]</h3></div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="FullName" class="font-weight-bold">@L["Full Name *"]</label>
                            <input asp-for="FullName" class="form-control">
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="Phone">@L["Phone"]</label>
                            <input asp-for="Phone" class="form-control" placeholder="+91 98765 43210">
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="Email">@L["Email"]</label>
                            <input asp-for="Email" type="email" class="form-control">
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="DateOfBirth">@L["Date of Birth"]</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control">
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="AadharNumber">@L["Aadhaar Number"]</label>
                            <input asp-for="AadharNumber" class="form-control" placeholder="XXXX XXXX XXXX">
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="PanNumber">@L["PAN Number"]</label>
                            <input asp-for="PanNumber" class="form-control" placeholder="ABCDE1234F" style="text-transform:uppercase;">
                        </div>
                        <div class="col-md-12 form-group">
                            <label asp-for="Address">@L["Address"]</label>
                            <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        </div>
                        @if (User.IsInRole("SuperAdmin") && ViewBag.Tenants != null)
                        {
                            <div class="col-md-12 form-group">
                                <label asp-for="TenantId" class="font-weight-bold">@L["Company *"]</label>
                                <select asp-for="TenantId" asp-items="ViewBag.Tenants" class="form-control"><option value="">— @L["Select"] —</option></select>
                            </div>
                        }
                        <div class="col-md-6 form-group">
                            <label asp-for="Status">@L["Status"]</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<FleetPro.Models.Entities.DriverStatus>()" class="form-control"></select>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="MonthlySalary">@L["Monthly Salary (₹)"]</label>
                            <div class="input-group">
                                <div class="input-group-prepend"><span class="input-group-text">₹</span></div>
                                <input asp-for="MonthlySalary" type="number" class="form-control">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-danger text-white"><h3 class="card-title"><i class="fas fa-id-card mr-2"></i>@L["License Details"]</h3></div>
                <div class="card-body">
                    <div class="form-group">
                        <label asp-for="LicenseNumber" class="font-weight-bold">@L["License Number *"]</label>
                        <input asp-for="LicenseNumber" class="form-control" placeholder="MH0219800012345">
                        <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="LicenseExpiry" class="font-weight-bold">@L["License Expiry *"]</label>
                        <input asp-for="LicenseExpiry" type="date" class="form-control">
                        <span asp-validation-for="LicenseExpiry" class="text-danger small"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="LicenseType">@L["License Type"]</label>
                        <select asp-for="LicenseType" class="form-control">
                            <option value="">— @L["Select"] —</option>
                            <option>HMV (Heavy Motor Vehicle)</option>
                            <option>LMV (Light Motor Vehicle)</option>
                            <option>HGMV (Heavy Goods Motor Vehicle)</option>
                            <option>Transport</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h3 class="card-title"><i class="fas fa-university mr-2"></i>@L["Bank Details"]</h3></div>
                <div class="card-body">
                    <div class="form-group">
                        <label asp-for="BankAccountNumber">@L["Account Number"]</label>
                        <input asp-for="BankAccountNumber" class="form-control">
                    </div>
                    <div class="form-group">
                        <label asp-for="IFSC">@L["IFSC Code"]</label>
                        <input asp-for="IFSC" class="form-control" placeholder="SBIN0001234" style="text-transform:uppercase;">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-right mb-3">
        <a asp-action="Index" class="btn btn-secondary mr-2"><i class="fas fa-times mr-1"></i>@L["Cancel"]</a>
        <button type="submit" class="btn btn-warning"><i class="fas fa-save mr-1"></i>@(isCreate ? L["Add Driver"].Value : L["Save Changes"].Value)</button>
    </div>
</form>
</div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
