@* ══════════════════ Views/Expense/Create.cshtml ══════════════════ *@
@model FleetPro.Models.ViewModels.ExpenseViewModel
@{
    bool isCreate = Model.Id == 0;
    ViewData["Title"] = isCreate ? L["Add Expense"].Value : L["Edit Expense"].Value;
}

<div class="content-header"><div class="container-fluid">
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">@ViewData["Title"]</h1></div>
        <div class="col-sm-6"><ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i></a></li>
            <li class="breadcrumb-item"><a asp-action="Index">@L["Expenses"]</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol></div>
    </div>
</div></div>

<section class="content"><div class="container-fluid">
<div class="row justify-content-center">
<div class="col-md-7">
<form asp-action="@(isCreate ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="card">
        <div class="card-header bg-danger text-white"><h3 class="card-title"><i class="fas fa-receipt mr-2"></i>@L["Expense Details"]</h3></div>
        <div class="card-body">
            <div class="form-group">
                <label asp-for="TripId" class="font-weight-bold">@L["Trip *"]</label>
                <select asp-for="TripId" asp-items="ViewBag.Trips" class="form-control">
                    <option value="">@L["— Select Trip —"]</option>
                </select>
                <span asp-validation-for="TripId" class="text-danger small"></span>
            </div>
            <div class="row">
                <div class="col-md-6 form-group">
                    <label asp-for="Category" class="font-weight-bold">@L["Category *"]</label>
                    <select asp-for="Category" asp-items="Html.GetEnumSelectList<FleetPro.Models.Entities.ExpenseCategory>()" class="form-control"></select>
                </div>
                <div class="col-md-6 form-group">
                    <label asp-for="Amount" class="font-weight-bold">@L["Amount (₹) *"]</label>
                    <div class="input-group">
                        <div class="input-group-prepend"><span class="input-group-text">₹</span></div>
                        <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control form-control-lg">
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="ExpenseDate" class="font-weight-bold">@L["Expense Date *"]</label>
                <input asp-for="ExpenseDate" type="date" class="form-control">
                <span asp-validation-for="ExpenseDate" class="text-danger small"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description">@L["Description / Notes"]</label>
                <input asp-for="Description" class="form-control" placeholder="Diesel 100L at ₹85/L">
            </div>
            <div class="row">
                <div class="col-md-6 form-group">
                    <label asp-for="VendorName">@L["Vendor / Supplier"]</label>
                    <input asp-for="VendorName" class="form-control" placeholder="HP Petrol Pump">
                </div>
                <div class="col-md-6 form-group">
                    <label asp-for="BillNumber">@L["Bill / Receipt Number"]</label>
                    <input asp-for="BillNumber" class="form-control" placeholder="BILL-2025-001">
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Receipt">@L["Upload Receipt / Bill"]</label>
                <div class="input-group">
                    <div class="custom-file">
                        <input asp-for="Receipt" type="file" class="custom-file-input" accept=".pdf,.jpg,.jpeg,.png" id="receiptFile">
                        <label class="custom-file-label" for="receiptFile">@L["Choose file (PDF/JPG/PNG)"]</label>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.ExistingReceiptPath))
                {
                    <small class="text-muted">@L["Current:"] <a href="@Model.ExistingReceiptPath" target="_blank">@L["View existing receipt"]</a></small>
                }
            </div>
        </div>
        <div class="card-footer text-right">
            <a asp-action="Index" class="btn btn-secondary mr-2"><i class="fas fa-times mr-1"></i>@L["Cancel"]</a>
            <button type="submit" class="btn btn-danger"><i class="fas fa-save mr-1"></i>@(isCreate ? L["Add Expense"].Value : L["Save Changes"].Value)</button>
        </div>
    </div>
</form>
</div></div>
</div></section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('.custom-file-input')?.addEventListener('change', function (e) {
            var fileName = e.target.files[0]?.name || 'Choose file';
            e.target.nextElementSibling.innerText = fileName;
        });
    </script>
}
