@* ══════════════════ Views/Expense/Index.cshtml ══════════════════ *@
@model List<FleetPro.Models.Entities.Expense>
@{
    ViewData["Title"] = L["Expenses"].Value;
    int? tripFilterId = ViewBag.TripFilter as int?;
}

<div class="content-header"><div class="container-fluid">
    <div class="row mb-2">
        <div class="col-sm-6">
            <h1 class="m-0">@L["Expenses"]</h1>
        </div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i></a></li>
                <li class="breadcrumb-item active">@L["Expenses"]</li>
            </ol>
        </div>
    </div>
</div></div>

<section class="content"><div class="container-fluid">

    <!-- Summary by Category -->
    <div class="row mb-3">
        @{
            var categories = ViewBag.Categories as List<FleetPro.Models.Entities.ExpenseCategoryMaster> ?? new();
            var grouped = Model.Where(e => e.CategoryId != null)
                .GroupBy(e => e.CategoryId)
                .ToDictionary(g => g.Key!.Value, g => g.Sum(e => e.Amount));
            var totalExp = Model.Sum(e => e.Amount);
        }
        <div class="col-md-2">
            <div class="info-box mb-0"><span class="info-box-icon bg-dark"><i class="fas fa-receipt"></i></span>
            <div class="info-box-content"><span class="info-box-text">@L["Total"]</span><span class="info-box-number">₹@totalExp.ToString("N0")</span></div></div>
        </div>
        @foreach (var catId in grouped.Keys.OrderByDescending(k => grouped[k]).Take(5))
        {
            var cat = categories.FirstOrDefault(c => c.Id == catId);
            var color = cat?.Color ?? "secondary";
            var icon = cat?.Icon ?? "fas fa-tag";
            <div class="col-md-2">
                <div class="info-box mb-0"><span class="info-box-icon bg-@color"><i class="@icon"></i></span>
                <div class="info-box-content"><span class="info-box-text">@(cat?.Name ?? "Unknown")</span><span class="info-box-number">₹@grouped[catId].ToString("N0")</span></div></div>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
            <div class="d-flex align-items-center flex-wrap" style="gap:6px;">
                @if (tripFilterId != null)
                {
                    var tripNum = Model.FirstOrDefault()?.Trip?.TripNumber ?? $"#{tripFilterId}";
                    <span class="badge badge-info p-2"><i class="fas fa-filter mr-1"></i>@L["Trip filter:"] @tripNum</span>
                    <a asp-action="Index" class="btn btn-xs btn-outline-secondary">@L["Remove filter"]</a>
                }
                <form method="get" class="form-inline" style="gap:6px;">
                    @if (tripFilterId != null)
                    {
                        <input type="hidden" name="tripId" value="@tripFilterId">
                    }
                    <select name="categoryId" class="form-control form-control-sm" onchange="this.form.submit()">
                        <option value="">@L["All Categories"]</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id" selected="@(Context.Request.Query["categoryId"] == c.Id.ToString() ? "selected" : null)">@c.Name</option>
                        }
                    </select>
                    <input name="search" value="@Context.Request.Query["search"]" class="form-control form-control-sm" placeholder="@L["Trip# / description…"]">
                    <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fas fa-search"></i></button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">@L["Clear"]</a>
                </form>
            </div>
            <button type="button" class="btn btn-danger" onclick="openAddExpenseModal()">
                <i class="fas fa-plus mr-1"></i>@L["Add Expense"]
            </button>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:90px;">@L["Actions"]</th>
                        <th>@L["Category"]</th><th>@L["Trip"]</th><th>@L["Amount"]</th><th>@L["Date"]</th><th>@L["Description"]</th><th>@L["Vendor"]</th><th>@L["Bill#"]</th><th>@L["Receipt"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td class="action-btn">
                                <button type="button" class="btn btn-xs btn-warning" onclick="openEditExpenseModal('@Ids.Protect(e.Id)')" title="Edit"><i class="fas fa-edit"></i></button>
                                <form asp-action="Delete" asp-route-eid="@Ids.Protect(e.Id)" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-xs btn-danger" data-confirm="@L["Delete this expense?"]" title="Delete"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                            <td>
                                @{
                                    var expCat = e.CategoryId.HasValue ? categories.FirstOrDefault(c => c.Id == e.CategoryId) : null;
                                    var badgeColor = expCat?.Color ?? "secondary";
                                    var catIcon = expCat?.Icon ?? "fas fa-tag";
                                    var catName = expCat?.Name ?? e.CategoryName;
                                }
                                <span class="badge badge-@badgeColor"><i class="@catIcon mr-1"></i>@catName</span>
                            </td>
                            <td><a asp-controller="Trip" asp-action="Details" asp-route-eid="@Ids.Protect(e.TripId)" class="font-weight-bold">@e.Trip?.TripNumber</a></td>
                            <td class="font-weight-bold text-danger">₹@e.Amount.ToString("N2")</td>
                            <td>@e.ExpenseDate.ToString("dd MMM yyyy")</td>
                            <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@e.Description">@e.Description</td>
                            <td>@e.VendorName</td>
                            <td>@e.BillNumber</td>
                            <td>
                                @if (e.HasReceipt && !string.IsNullOrEmpty(e.ReceiptPath))
                                { <a href="@e.ReceiptPath" target="_blank" class="btn btn-xs btn-outline-info"><i class="fas fa-file-invoice"></i> @L["View"]</a> }
                                else { <span class="text-muted small">—</span> }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    { <tr><td colspan="9" class="text-center text-muted py-4">@L["No expenses found."]</td></tr> }
                </tbody>
                @if (Model.Any())
                {
                    <tfoot class="bg-light font-weight-bold">
                        <tr>
                            <td colspan="3" class="text-right">@L["Total:"]</td>
                            <td class="text-danger">₹@Model.Sum(e => e.Amount).ToString("N2")</td>
                            <td colspan="5"></td>
                        </tr>
                                    </tfoot>
                                    }
                                </table>
                            </div>
                        </div>
                    </div></section>

                    <!-- Expense Modal (Add/Edit) -->
                    <div class="modal fade" id="expenseModal" tabindex="-1" role="dialog">
                        <div class="modal-dialog modal-lg" role="document">
                            <div class="modal-content">
                                <form id="expenseForm" method="post" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" id="expenseId" name="Id" value="0" />
                                    <input type="hidden" id="expenseEid" name="eid" value="" />
                                    <div class="modal-header bg-danger text-white">
                                        <h5 class="modal-title"><i class="fas fa-receipt mr-2"></i><span id="expenseModalTitle">@L["Add Expense"]</span></h5>
                                        <button type="button" class="close text-white" data-dismiss="modal">
                                            <span>&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row">
                                            <div class="col-md-6 form-group">
                                                <label class="font-weight-bold">@L["Trip"] <span class="text-danger">*</span></label>
                                                <select name="TripId" id="modalTripId" class="form-control" required>
                                                    <option value="">@L["— Select Trip —"]</option>
                                                    @if (ViewBag.Trips != null)
                                                    {
                                                        foreach (SelectListItem item in ViewBag.Trips)
                                                        {
                                                            <option value="@item.Value">@item.Text</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-6 form-group">
                                                <label class="font-weight-bold">@L["Category"] <span class="text-danger">*</span></label>
                                                <select name="CategoryId" id="modalCategory" class="form-control" required>
                                                    <option value="">@L["— Select Category —"]</option>
                                                    @foreach (var c in categories)
                                                    {
                                                        <option value="@c.Id">@c.Name</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6 form-group">
                                                <label class="font-weight-bold">@L["Amount (₹)"] <span class="text-danger">*</span></label>
                                                <div class="input-group">
                                                    <div class="input-group-prepend"><span class="input-group-text">₹</span></div>
                                                    <input type="number" name="Amount" id="modalAmount" step="0.01" min="0.01" class="form-control form-control-lg" required>
                                                </div>
                                            </div>
                                            <div class="col-md-6 form-group">
                                                <label class="font-weight-bold">@L["Expense Date"] <span class="text-danger">*</span></label>
                                                <input type="date" name="ExpenseDate" id="modalExpenseDate" class="form-control" required>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label>@L["Description / Notes"]</label>
                                            <input type="text" name="Description" id="modalDescription" class="form-control" placeholder="Diesel 100L at ₹85/L">
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6 form-group">
                                                <label>@L["Vendor / Supplier"]</label>
                                                <input type="text" name="VendorName" id="modalVendorName" class="form-control" placeholder="HP Petrol Pump">
                                            </div>
                                            <div class="col-md-6 form-group">
                                                <label>@L["Bill / Receipt Number"]</label>
                                                <input type="text" name="BillNumber" id="modalBillNumber" class="form-control" placeholder="BILL-2025-001">
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label>@L["Upload Receipt / Bill"]</label>
                                            <div class="input-group">
                                                <div class="custom-file">
                                                    <input type="file" name="Receipt" class="custom-file-input" accept=".pdf,.jpg,.jpeg,.png" id="modalReceiptFile">
                                                    <label class="custom-file-label" for="modalReceiptFile" id="modalReceiptLabel">@L["Choose file (PDF/JPG/PNG)"]</label>
                                                </div>
                                            </div>
                                            <small id="existingReceiptInfo" class="text-muted d-none"></small>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fas fa-times mr-1"></i>@L["Cancel"]</button>
                                        <button type="submit" class="btn btn-danger"><i class="fas fa-save mr-1"></i><span id="expenseSubmitText">@L["Add Expense"]</span></button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    @section Scripts {
                    <script>
                        function openAddExpenseModal() {
                            // Reset form
                            document.getElementById('expenseForm').reset();
                            document.getElementById('expenseId').value = '0';
                            document.getElementById('expenseEid').value = '';
                            document.getElementById('expenseForm').action = '@Url.Action("Create")';
                            document.getElementById('expenseModalTitle').innerText = '@L["Add Expense"]';
                            document.getElementById('expenseSubmitText').innerText = '@L["Add Expense"]';
                            document.getElementById('modalReceiptLabel').innerText = '@L["Choose file (PDF/JPG/PNG)"]';
                            document.getElementById('existingReceiptInfo').classList.add('d-none');
                            // Set today's date as default
                            document.getElementById('modalExpenseDate').value = new Date().toISOString().split('T')[0];
                            $('#expenseModal').modal('show');
                        }

                        function openEditExpenseModal(eid) {
                            // Reset form first
                            document.getElementById('expenseForm').reset();
                            document.getElementById('expenseId').value = '0';
                            document.getElementById('expenseEid').value = eid;
                            document.getElementById('expenseForm').action = '@Url.Action("Edit")' + '?eid=' + eid;
                            document.getElementById('expenseModalTitle').innerText = '@L["Edit Expense"]';
                            document.getElementById('expenseSubmitText').innerText = '@L["Save Changes"]';
                            document.getElementById('modalReceiptLabel').innerText = '@L["Choose file (PDF/JPG/PNG)"]';

                            // Load expense data via AJAX
                            $.get('@Url.Action("GetExpense")' + '?eid=' + eid, function(data) {
                                document.getElementById('expenseId').value = data.id;
                                document.getElementById('modalTripId').value = data.tripId;
                                document.getElementById('modalCategory').value = data.categoryId || '';
                                document.getElementById('modalAmount').value = data.amount;
                                document.getElementById('modalExpenseDate').value = data.expenseDate;
                                document.getElementById('modalDescription').value = data.description || '';
                                document.getElementById('modalVendorName').value = data.vendorName || '';
                                document.getElementById('modalBillNumber').value = data.billNumber || '';

                                if (data.receiptPath) {
                                    document.getElementById('existingReceiptInfo').innerHTML = 
                                        '<i class="fas fa-paperclip mr-1"></i>@L["Existing receipt:"] <a href="' + data.receiptPath + '" target="_blank">@L["View"]</a>';
                                    document.getElementById('existingReceiptInfo').classList.remove('d-none');
                                } else {
                                    document.getElementById('existingReceiptInfo').classList.add('d-none');
                                }
                            });

                            $('#expenseModal').modal('show');
                        }

                        // File input label update
                        document.getElementById('modalReceiptFile')?.addEventListener('change', function(e) {
                            var fileName = e.target.files[0]?.name || '@L["Choose file (PDF/JPG/PNG)"]';
                            document.getElementById('modalReceiptLabel').innerText = fileName;
                        });
                    </script>
                    }
