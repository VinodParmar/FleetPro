@* ══════════════════ Views/Role/Index.cshtml ══════════════════ *@
@model List<FleetPro.Models.ViewModels.RoleListViewModel>
@{
    ViewData["Title"] = "Roles & Permissions";
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
}

<div class="content-header"><div class="container-fluid">
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0"><i class="fas fa-shield-alt mr-2"></i>Roles &amp; Permissions</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i></a></li>
                <li class="breadcrumb-item active">Roles</li>
            </ol>
            <div class="text-right mt-1">
                <form asp-action="ReseedPermissions" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-warning"
                            onclick="return confirm('Re-seed all role permissions? Missing entries will be added.')">
                        <i class="fas fa-sync mr-1"></i>Re-seed Permissions
                    </button>
                </form>
            </div>
        </div>
    </div>
</div></div>

<section class="content"><div class="container-fluid">

    <div class="alert alert-info">
        <i class="fas fa-info-circle mr-2"></i>
        <strong>How it works:</strong>
        Roles define the <strong>baseline permissions</strong> for all users assigned to them.
        Individual user overrides (Grant / Deny) can extend or restrict a role's permissions for a specific user.
        Only <strong>SuperAdmin</strong> can edit role permissions.
    </div>

    <div class="card">
        <div class="card-header"><h3 class="card-title"><i class="fas fa-list mr-2"></i>All Roles</h3></div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:110px;">Actions</th>
                        <th>Role Name</th>
                        <th>Description</th>
                        <th style="width:80px;">Type</th>
                        <th style="width:100px;">Permissions</th>
                        <th style="width:80px;">Users</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in Model)
                    {
                        <tr>
                            <td>
                                @if (isSuperAdmin)
                                {
                                    <a asp-action="Permissions" asp-route-eid="@Ids.Protect(role.Id)"
                                       class="btn btn-sm btn-primary">
                                        <i class="fas fa-key mr-1"></i>Permissions
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Permissions" asp-route-eid="@Ids.Protect(role.Id)"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="fas fa-eye mr-1"></i>View
                                    </a>
                                }
                            </td>
                            <td>
                                <strong>@role.Name</strong>
                                @if (role.IsSystemRole)
                                { <span class="badge badge-secondary ml-1" style="font-size:10px;">System</span> }
                            </td>
                            <td class="text-muted">@(role.Description ?? "—")</td>
                            <td>
                                @if (role.IsSystemRole)
                                { <span class="badge badge-dark">System</span> }
                                else
                                { <span class="badge badge-info">Custom</span> }
                            </td>
                            <td class="text-center">
                                <span class="badge badge-primary px-2">@role.PermissionCount</span>
                            </td>
                            <td class="text-center">
                                <span class="badge badge-secondary px-2">@role.UserCount</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Permission Matrix Legend -->
    <div class="card">
        <div class="card-header bg-light"><h3 class="card-title"><i class="fas fa-table mr-2"></i>Permission Matrix Overview</h3></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-bordered mb-0" style="font-size:12px;">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>Module · Action</th>
                            @foreach (var role in Model)
                            { <th class="text-center">@role.Name</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var allRolePerms = ViewBag.AllRolePerms as List<(int RoleId, int PermId)> ?? new();
                        }
                        @foreach (var grp in (ViewBag.AllPermissions as IEnumerable<FleetPro.Models.Entities.Permission> ?? []).GroupBy(p => p.Module))
                        {
                            <tr class="table-light"><td colspan="@(Model.Count + 1)" class="font-weight-bold py-1 px-2">@grp.Key</td></tr>
                            @foreach (var perm in grp.OrderBy(p => p.Action))
                            {
                                <tr>
                                    <td class="pl-4 text-muted">@perm.Action</td>
                                    @foreach (var role in Model)
                                    {
                                        var isGranted = ViewBag.GrantedMatrix != null &&
                                                ((Dictionary<(int,int),bool>)ViewBag.GrantedMatrix).ContainsKey((role.Id, perm.Id));
                                        <td class="text-center">
                                            @if (isGranted)
                                            { <i class="fas fa-check text-success"></i> }
                                            else
                                            { <i class="fas fa-times text-danger" style="opacity:.3;"></i> }
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div></section>
