@model FleetPro.Services.DashboardStats
@{
    ViewData["Title"] = L["Dashboard"].Value;
    bool isSA = User.IsInRole("SuperAdmin");
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0">@L["Dashboard"]</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right"><li class="breadcrumb-item active">@L["Dashboard"]</li></ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <!-- ── STAT CARDS ── -->
        <div class="row">
            @if (isSA)
            {
                <div class="col-lg-3 col-6">
                    <div class="small-box bg-gradient-info">
                        <div class="inner"><h3>@Model.TotalTenants</h3><p>@L["Total Tenants"]</p></div>
                        <div class="icon"><i class="fas fa-building"></i></div>
                        <a asp-controller="Tenant" asp-action="Index" class="small-box-footer">@L["Manage"] <i class="fas fa-arrow-circle-right"></i></a>
                    </div>
                </div>
            }
            <div class="col-lg-3 col-6">
                <div class="small-box bg-gradient-success">
                    <div class="inner"><h3>@Model.ActiveTrucks <small style="font-size:50%">/ @Model.TotalTrucks</small></h3><p>@L["Active Trucks"]</p></div>
                    <div class="icon"><i class="fas fa-truck"></i></div>
                    <a asp-controller="Truck" asp-action="Index" class="small-box-footer">@L["Manage"] <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-gradient-warning">
                    <div class="inner"><h3>@Model.ActiveTrips</h3><p>@L["Active Trips"]</p></div>
                    <div class="icon"><i class="fas fa-route"></i></div>
                    <a asp-controller="Trip" asp-action="Index" class="small-box-footer">@L["Manage"] <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-gradient-danger">
                    <div class="inner"><h3>@Model.TotalDrivers</h3><p>@L["Total Drivers"]</p></div>
                    <div class="icon"><i class="fas fa-user-tie"></i></div>
                    <a asp-controller="Driver" asp-action="Index" class="small-box-footer">@L["Manage"] <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
        </div>

        <!-- ── FINANCIAL CARDS ── -->
        <div class="row">
            <div class="col-md-4">
                <div class="info-box bg-gradient-success">
                    <span class="info-box-icon"><i class="fas fa-rupee-sign"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">@L["Monthly Revenue"]</span>
                        <span class="info-box-number">₹@Model.MonthlyRevenue.ToString("N0")</span>
                        <div class="progress"><div class="progress-bar" style="width: 100%"></div></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-box bg-gradient-danger">
                    <span class="info-box-icon"><i class="fas fa-money-bill-wave"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">@L["Monthly Expenses"]</span>
                        <span class="info-box-number">₹@Model.MonthlyExpenses.ToString("N0")</span>
                        <div class="progress"><div class="progress-bar" style="width: @(Model.MonthlyRevenue > 0 ? (int)(Model.MonthlyExpenses / Model.MonthlyRevenue * 100) : 0)%"></div></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-box @(Model.NetProfit >= 0 ? "bg-gradient-primary" : "bg-gradient-warning")">
                    <span class="info-box-icon"><i class="fas fa-chart-line"></i></span>
                    <div class="info-box-content">
                        <span class="info-box-text">@L["Net Profit"]</span>
                        <span class="info-box-number">₹@Model.NetProfit.ToString("N0")</span>
                        <div class="progress"><div class="progress-bar" style="width: @(Model.MonthlyRevenue > 0 ? Math.Max(0, (int)(Model.NetProfit / Model.MonthlyRevenue * 100)) : 0)%"></div></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── CHARTS ROW 1 ── -->
        <div class="row">
            <!-- Revenue vs Expenses (Bar/Line Chart) -->
            <div class="col-lg-8">
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-chart-area mr-2"></i>@L["Revenue vs Expenses"] (Last 6 Months)</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-minus"></i></button>
                        </div>
                    </div>
                    <div class="card-body">
                        <canvas id="revenueExpenseChart" height="250"></canvas>
                    </div>
                </div>
            </div>

            <!-- Trip Status (Doughnut) -->
            <div class="col-lg-4">
                <div class="card card-success card-outline">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-chart-pie mr-2"></i>@L["Trip Status"]</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-minus"></i></button>
                        </div>
                    </div>
                    <div class="card-body">
                        <canvas id="tripStatusChart" height="250"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── CHARTS ROW 2 ── -->
        <div class="row">
            <!-- Expense by Category (Pie) -->
            <div class="col-lg-4">
                <div class="card card-danger card-outline">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-chart-pie mr-2"></i>@L["Expenses by Category"]</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-minus"></i></button>
                        </div>
                    </div>
                    <div class="card-body">
                        <canvas id="expenseCategoryChart" height="250"></canvas>
                    </div>
                </div>
            </div>

            <!-- Truck Status (Doughnut) -->
            <div class="col-lg-4">
                <div class="card card-warning card-outline">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-truck mr-2"></i>@L["Truck Status"]</h3>
                        <div class="card-tools">
                            <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-minus"></i></button>
                        </div>
                    </div>
                    <div class="card-body">
                        <canvas id="truckStatusChart" height="250"></canvas>
                    </div>
                </div>
            </div>

            <!-- Urgent Alerts -->
            <div class="col-lg-4">
                <div class="card card-danger">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-exclamation-triangle mr-2"></i>@L["Urgent Alerts"]</h3>
                        <div class="card-tools">
                            <span class="badge badge-light">@Model.CriticalAlerts @L["Critical"]</span>
                        </div>
                    </div>
                    <div class="card-body p-0" style="max-height:280px;overflow-y:auto;">
                        <ul class="list-group list-group-flush">
                            @foreach (var a in Model.UrgentAlerts)
                            {
                                <li class="list-group-item d-flex align-items-start py-2">
                                    <span class="badge @(a.Severity == FleetPro.Models.Entities.AlertSeverity.Critical ? "badge-danger" : "badge-warning") mr-2 mt-1">
                                        @(a.DaysRemaining <= 0 ? L["Expired"].Value : a.DaysRemaining + "d")
                                    </span>
                                    <small><strong>@a.Title</strong></small>
                                </li>
                            }
                            @if (!Model.UrgentAlerts.Any())
                            {
                                <li class="list-group-item text-center text-success py-4">
                                    <i class="fas fa-check-circle fa-2x mb-2"></i><br>
                                    No urgent alerts!
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="card-footer text-right">
                        <a asp-controller="Alert" asp-action="Index" class="text-danger">@L["View All Alerts →"]</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── RECENT TRIPS TABLE ── -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-route mr-2"></i>@L["Recent Trips"]</h3>
                        <div class="card-tools">
                            <a asp-controller="Trip" asp-action="Create" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus mr-1"></i>@L["New Trip"]
                            </a>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-sm table-hover table-striped mb-0">
                            <thead class="thead-dark">
                                <tr>
                                    <th style="width:90px;">@L["Actions"]</th>
                                    <th>@L["Trip #"]</th>
                                    <th>@L["Route"]</th>
                                    <th>@L["Truck"]</th>
                                    <th>@L["Driver"]</th>
                                    <th>@L["Revenue"]</th>
                                    <th>@L["Expenses"]</th>
                                    <th>@L["Profit"]</th>
                                    <th>@L["Status"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.RecentTrips)
                                {
                                    var profit = t.Revenue - t.TotalExpenses;
                                    <tr>
                                        <td class="action-btn">
                                            <a asp-controller="Trip" asp-action="Details" asp-route-eid="@Ids.Protect(t.Id)" class="btn btn-xs btn-info" title="View"><i class="fas fa-eye"></i></a>
                                            <a asp-controller="Trip" asp-action="Edit" asp-route-eid="@Ids.Protect(t.Id)" class="btn btn-xs btn-warning" title="Edit"><i class="fas fa-edit"></i></a>
                                        </td>
                                        <td><strong>@t.TripNumber</strong></td>
                                        <td class="small">@t.FromLocation → @t.ToLocation</td>
                                        <td><span class="badge badge-secondary">@t.Truck?.NumberPlate</span></td>
                                        <td>@t.Driver?.FullName</td>
                                        <td class="text-success font-weight-bold">₹@t.Revenue.ToString("N0")</td>
                                        <td class="text-danger">₹@t.TotalExpenses.ToString("N0")</td>
                                        <td class="@(profit >= 0 ? "text-primary" : "text-danger") font-weight-bold">₹@profit.ToString("N0")</td>
                                        <td>
                                            @switch (t.Status)
                                            {
                                                case FleetPro.Models.Entities.TripStatus.Completed: <span class="badge badge-success">@L["Completed"]</span> break;
                                                case FleetPro.Models.Entities.TripStatus.InProgress: <span class="badge badge-warning">@L["In Progress"]</span> break;
                                                case FleetPro.Models.Entities.TripStatus.Scheduled: <span class="badge badge-info">@L["Scheduled"]</span> break;
                                                case FleetPro.Models.Entities.TripStatus.Cancelled: <span class="badge badge-danger">@L["Cancelled"]</span> break;
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (!Model.RecentTrips.Any())
                                {
                                    <tr><td colspan="9" class="text-center text-muted py-4">No trips yet. <a asp-controller="Trip" asp-action="Create">Create your first trip!</a></td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer text-right">
                        <a asp-controller="Trip" asp-action="Index">@L["View All Trips →"]</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Color palette
            const colors = {
                primary: 'rgba(0, 123, 255, 0.8)',
                success: 'rgba(40, 167, 69, 0.8)',
                danger: 'rgba(220, 53, 69, 0.8)',
                warning: 'rgba(255, 193, 7, 0.8)',
                info: 'rgba(23, 162, 184, 0.8)',
                secondary: 'rgba(108, 117, 125, 0.8)',
                purple: 'rgba(111, 66, 193, 0.8)',
                pink: 'rgba(232, 62, 140, 0.8)',
                orange: 'rgba(253, 126, 20, 0.8)',
                teal: 'rgba(32, 201, 151, 0.8)'
            };

            // 1. Revenue vs Expenses Chart (Bar + Line)
            const revenueExpenseCtx = document.getElementById('revenueExpenseChart').getContext('2d');
            new Chart(revenueExpenseCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
                    datasets: [
                        {
                            label: '@L["Revenue"]',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueData)),
                            backgroundColor: 'rgba(40, 167, 69, 0.7)',
                            borderColor: 'rgba(40, 167, 69, 1)',
                            borderWidth: 2,
                            borderRadius: 5,
                            order: 2
                        },
                        {
                            label: '@L["Expenses"]',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseData)),
                            backgroundColor: 'rgba(220, 53, 69, 0.7)',
                            borderColor: 'rgba(220, 53, 69, 1)',
                            borderWidth: 2,
                            borderRadius: 5,
                            order: 2
                        },
                        {
                            label: '@L["Net Profit"]',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueData.Zip(Model.ExpenseData, (r, e) => r - e).ToList())),
                            type: 'line',
                            fill: false,
                            borderColor: 'rgba(0, 123, 255, 1)',
                            backgroundColor: 'rgba(0, 123, 255, 0.2)',
                            borderWidth: 3,
                            pointRadius: 5,
                            pointBackgroundColor: 'rgba(0, 123, 255, 1)',
                            tension: 0.3,
                            order: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ₹' + context.raw.toLocaleString('en-IN');
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) { return '₹' + value.toLocaleString('en-IN'); }
                            }
                        }
                    }
                }
            });

            // 2. Trip Status Doughnut Chart
            const tripStatusCtx = document.getElementById('tripStatusChart').getContext('2d');
            const tripStatusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TripStatusData));
            new Chart(tripStatusCtx, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(tripStatusData),
                    datasets: [{
                        data: Object.values(tripStatusData),
                        backgroundColor: [colors.success, colors.warning, colors.info, colors.danger, colors.secondary],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '60%',
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            // 3. Expense Category Pie Chart
            const expenseCategoryCtx = document.getElementById('expenseCategoryChart').getContext('2d');
            const expenseCategoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseCategoryData));
            new Chart(expenseCategoryCtx, {
                type: 'pie',
                data: {
                    labels: Object.keys(expenseCategoryData),
                    datasets: [{
                        data: Object.values(expenseCategoryData),
                        backgroundColor: [colors.primary, colors.danger, colors.warning, colors.info, colors.success, colors.purple, colors.pink, colors.orange, colors.teal, colors.secondary],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ₹' + context.raw.toLocaleString('en-IN');
                                }
                            }
                        }
                    }
                }
            });

            // 4. Truck Status Doughnut Chart
            const truckStatusCtx = document.getElementById('truckStatusChart').getContext('2d');
            const truckStatusData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TruckStatusData));
            new Chart(truckStatusCtx, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(truckStatusData),
                    datasets: [{
                        data: Object.values(truckStatusData),
                        backgroundColor: [colors.success, colors.warning, colors.danger, colors.secondary],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '60%',
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        });
    </script>
}
