@* ══════════════════ Views/Trip/Create.cshtml ══════════════════ *@
@model FleetPro.Models.ViewModels.TripViewModel
@{
    bool isCreate = Model.Id == 0;
    ViewData["Title"] = isCreate ? L["New Trip"].Value : L["Edit Trip"].Value + " — " + Model.TripNumber;
}

<div class="content-header"><div class="container-fluid">
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">@ViewData["Title"]</h1></div>
        <div class="col-sm-6"><ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i></a></li>
            <li class="breadcrumb-item"><a asp-action="Index">@L["Trips"]</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol></div>
    </div>
</div></div>

<section class="content"><div class="container-fluid">
<form asp-action="@(isCreate ? "Create" : "Edit")" asp-route-eid="@Ids.Protect(Model.Id)" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title"><i class="fas fa-route mr-2"></i>@L["Trip Details"]</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="TruckId" class="font-weight-bold">@L["Truck"] *</label>
                            <select asp-for="TruckId" asp-items="ViewBag.Trucks" class="form-control">
                                <option value="">@L["— Select Truck —"]</option>
                            </select>
                            <span asp-validation-for="TruckId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="DriverId" class="font-weight-bold">@L["Driver"] *</label>
                            <select asp-for="DriverId" asp-items="ViewBag.Drivers" class="form-control">
                                <option value="">@L["— Select Driver —"]</option>
                            </select>
                            <span asp-validation-for="DriverId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="FromLocation" class="font-weight-bold">@L["From Location *"]</label>
                            <input asp-for="FromLocation" class="form-control" placeholder="Mumbai, Maharashtra">
                            <span asp-validation-for="FromLocation" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="ToLocation" class="font-weight-bold">@L["To Location *"]</label>
                            <input asp-for="ToLocation" class="form-control" placeholder="Delhi, NCR">
                            <span asp-validation-for="ToLocation" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 form-group">
                            <label asp-for="StartDate" class="font-weight-bold">@L["Start Date *"]</label>
                            <input asp-for="StartDate" type="date" class="form-control">
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 form-group">
                            <label asp-for="EndDate">@L["End Date"]</label>
                            <input asp-for="EndDate" type="date" class="form-control">
                        </div>
                        <div class="col-md-4 form-group">
                            <label asp-for="DistanceKm">@L["Distance (km)"]</label>
                            <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" placeholder="1421">
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="CargoDescription">@L["Cargo Description"]</label>
                            <input asp-for="CargoDescription" class="form-control" placeholder="FMCG Goods">
                        </div>
                        <div class="col-md-3 form-group">
                            <label asp-for="CargoWeightTons">@L["Cargo Weight (Tons)"]</label>
                            <input asp-for="CargoWeightTons" type="number" step="0.5" class="form-control">
                        </div>
                        <div class="col-md-3 form-group">
                            <label asp-for="Status" class="font-weight-bold">@L["Status"]</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<FleetPro.Models.Entities.TripStatus>()" class="form-control"></select>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="ClientName">@L["Client Name"]</label>
                            <input asp-for="ClientName" class="form-control" placeholder="Reliance Retail">
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="LRNumber">@L["LR Number (Lorry Receipt)"]</label>
                            <input asp-for="LRNumber" class="form-control" placeholder="LR-2025-001">
                        </div>
                        <div class="col-md-12 form-group">
                            <label asp-for="Notes">@L["Notes"]</label>
                            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <h3 class="card-title"><i class="fas fa-rupee-sign mr-2"></i>@L["Revenue"]</h3>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label asp-for="Revenue" class="font-weight-bold">@L["Revenue Amount (₹) *"]</label>
                        <div class="input-group">
                            <div class="input-group-prepend"><span class="input-group-text">₹</span></div>
                            <input asp-for="Revenue" type="number" step="0.01" min="0" class="form-control form-control-lg" placeholder="45000">
                        </div>
                        <span asp-validation-for="Revenue" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header"><h3 class="card-title"><i class="fas fa-info-circle mr-2"></i>@L["Quick Tips"]</h3></div>
                <div class="card-body text-muted small">
                    <ul class="pl-3 mb-0">
                        <li>@L["Add expenses after creating the trip"]</li>
                        <li>@L["Upload documents (LR, Invoice) in trip details"]</li>
                        <li>@L["P&L is auto-calculated from Revenue − Expenses"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="text-right mb-3">
        <a asp-action="Index" class="btn btn-secondary mr-2"><i class="fas fa-times mr-1"></i>@L["Cancel"]</a>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save mr-1"></i>@(isCreate ? L["Create Trip"].Value : L["Save Changes"].Value)</button>
    </div>
</form>
</div></section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
