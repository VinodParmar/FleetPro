@* ══════════════════ Views/Trip/Details.cshtml ══════════════════ *@
@model FleetPro.Models.Entities.Trip
@{
    ViewData["Title"] = "Trip — " + Model.TripNumber;
}

<div class="content-header"><div class="container-fluid">
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">@L["Trip"] @Model.TripNumber</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i></a></li>
                <li class="breadcrumb-item"><a asp-action="Index">@L["Trips"]</a></li>
                <li class="breadcrumb-item active">@Model.TripNumber</li>
            </ol>
            <div class="text-right mt-1" style="display:flex;flex-wrap:wrap;gap:4px;justify-content:flex-end;">
                <a asp-action="Edit" asp-route-eid="@Ids.Protect(Model.Id)" class="btn btn-warning btn-sm"><i class="fas fa-edit mr-1"></i>@L["Edit"]</a>
                @if (Model.TruckId > 0)
                {
                    <a asp-controller="Truck" asp-action="Edit" asp-route-eid="@Ids.Protect(Model.TruckId)" class="btn btn-sm btn-outline-primary"><i class="fas fa-truck mr-1"></i>@L["Truck"]</a>
                }
                @if (Model.DriverId > 0)
                {
                    <a asp-controller="Driver" asp-action="Edit" asp-route-eid="@Ids.Protect(Model.DriverId)" class="btn btn-sm btn-outline-info"><i class="fas fa-user-tie mr-1"></i>@L["Driver"]</a>
                }
                <a asp-controller="Expense" asp-action="Index" asp-route-tripId="@Model.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-receipt mr-1"></i>@L["Expenses"]</a>
                <a asp-action="Index" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left mr-1"></i>@L["Back"]</a>
            </div>
        </div>
    </div>
</div></div>

<section class="content"><div class="container-fluid">
    <div class="row">

        <!-- Left: Trip Info + P&L -->
        <div class="col-md-5">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title"><i class="fas fa-route mr-2"></i>@L["Trip Information"]</h3>
                    <div class="card-tools">
                        @switch (Model.Status)
                        {
                            case FleetPro.Models.Entities.TripStatus.Completed:  <span class="badge badge-success">@L["Completed"]</span>  break;
                            case FleetPro.Models.Entities.TripStatus.InProgress: <span class="badge badge-warning">@L["In Progress"]</span> break;
                            case FleetPro.Models.Entities.TripStatus.Scheduled:  <span class="badge badge-info">@L["Scheduled"]</span>    break;
                            case FleetPro.Models.Entities.TripStatus.Cancelled:  <span class="badge badge-danger">@L["Cancelled"]</span>   break;
                        }
                    </div>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm table-borderless mb-0">
                        <tr><th class="text-muted" style="width:40%">@L["Trip Number"]</th><td><strong>@Model.TripNumber</strong></td></tr>
                        <tr><th class="text-muted">@L["Truck"]</th><td><a asp-controller="Truck" asp-action="Edit" asp-route-eid="@Ids.Protect(Model.TruckId)" class="font-weight-bold">@Model.Truck?.NumberPlate</a> <span class="text-muted">(@Model.Truck?.Model)</span></td></tr>
                        <tr><th class="text-muted">@L["Driver"]</th><td><a asp-controller="Driver" asp-action="Edit" asp-route-eid="@Ids.Protect(Model.DriverId)" class="font-weight-bold">@Model.Driver?.FullName</a></td></tr>
                        <tr><th class="text-muted">@L["From"]</th><td>@Model.FromLocation</td></tr>
                        <tr><th class="text-muted">@L["To"]</th><td>@Model.ToLocation</td></tr>
                        <tr><th class="text-muted">@L["Start Date"]</th><td>@Model.StartDate.ToString("dd MMM yyyy")</td></tr>
                        <tr><th class="text-muted">@L["End Date"]</th><td>@(Model.EndDate?.ToString("dd MMM yyyy") ?? "—")</td></tr>
                        <tr><th class="text-muted">@L["Distance"]</th><td>@(Model.DistanceKm?.ToString("N0") ?? "—") km</td></tr>
                        <tr><th class="text-muted">@L["Cargo"]</th><td>@(Model.CargoDescription ?? "—")</td></tr>
                        <tr><th class="text-muted">@L["Weight"]</th><td>@(Model.CargoWeightTons?.ToString("N1") ?? "—") tons</td></tr>
                        <tr><th class="text-muted">@L["Client"]</th><td>@(Model.ClientName ?? "—")</td></tr>
                        <tr><th class="text-muted">@L["LR Number"]</th><td>@(Model.LRNumber ?? "—")</td></tr>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        { <tr><th class="text-muted">@L["Notes"]</th><td>@Model.Notes</td></tr> }
                    </table>
                </div>
            </div>

            <!-- P&L Card -->
            <div class="card">
                <div class="card-header bg-dark text-white"><h3 class="card-title"><i class="fas fa-chart-line mr-2"></i>@L["Profit & Loss"]</h3></div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <tr class="table-success"><td class="font-weight-bold">@L["Revenue"]</td><td class="text-right font-weight-bold text-success">₹@Model.Revenue.ToString("N2")</td></tr>
                        @foreach (var grp in Model.Expenses.Where(e=>!e.IsDeleted).GroupBy(e => e.Category).OrderBy(g => g.Key.ToString()))
                        {
                            <tr><td class="text-muted pl-3">@grp.Key</td><td class="text-right text-danger">−₹@grp.Sum(e => e.Amount).ToString("N2")</td></tr>
                        }
                        <tr class="table-danger"><td class="font-weight-bold">@L["Total Expenses"]</td><td class="text-right font-weight-bold text-danger">₹@Model.TotalExpenses.ToString("N2")</td></tr>
                        <tr class="@(Model.NetProfit >= 0 ? "table-primary" : "table-warning")">
                            <td class="font-weight-bold">@L["Net Profit"]</td>
                            <td class="text-right font-weight-bold @(Model.NetProfit >= 0 ? "text-primary" : "text-danger")">
                                ₹@Model.NetProfit.ToString("N2")
                                @if (Model.Revenue > 0)
                                { <small class="badge @(Model.NetProfit >= 0 ? "badge-primary" : "badge-warning")">@((Model.NetProfit/Model.Revenue*100).ToString("N1"))%</small> }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right: Expenses + Documents -->
        <div class="col-md-7">

            <!-- Expenses -->
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-receipt mr-2"></i>@L["Expenses"]</h3>
                    <div class="card-tools">
                        <a asp-controller="Expense" asp-action="Create" asp-route-tripId="@Model.Id" class="btn btn-sm btn-danger">
                            <i class="fas fa-plus mr-1"></i>@L["Add Expense"]
                        </a>
                    </div>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th style="width:80px;">@L["Actions"]</th>
                                <th>@L["Category"]</th><th>@L["Amount"]</th><th>@L["Date"]</th><th>@L["Description"]</th><th>@L["Bill"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in Model.Expenses.Where(x => !x.IsDeleted).OrderByDescending(x => x.ExpenseDate))
                            {
                                <tr>
                                    <td class="action-btn">
                                        <a asp-controller="Expense" asp-action="Edit" asp-route-eid="@Ids.Protect(e.Id)" class="btn btn-xs btn-warning" title="Edit"><i class="fas fa-edit"></i></a>
                                        <form asp-controller="Expense" asp-action="Delete" asp-route-eid="@Ids.Protect(e.Id)" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-xs btn-danger" data-confirm="@L["Delete this expense?"]" title="Delete"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </td>
                                    <td>
                                        @{
                                            var catColor = e.Category switch {
                                                FleetPro.Models.Entities.ExpenseCategory.Fuel => "primary",
                                                FleetPro.Models.Entities.ExpenseCategory.Maintenance => "danger",
                                                FleetPro.Models.Entities.ExpenseCategory.Toll => "warning",
                                                FleetPro.Models.Entities.ExpenseCategory.Wages => "purple",
                                                _ => "secondary"
                                            };
                                        }
                                        <span class="badge badge-@catColor">@e.Category</span>
                                    </td>
                                    <td class="font-weight-bold text-danger">₹@e.Amount.ToString("N0")</td>
                                    <td>@e.ExpenseDate.ToString("dd MMM")</td>
                                    <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@e.Description">@e.Description</td>
                                    <td>
                                        @if (e.HasReceipt && !string.IsNullOrEmpty(e.ReceiptPath))
                                        { <a href="@e.ReceiptPath" target="_blank" class="btn btn-xs btn-outline-info"><i class="fas fa-file-pdf"></i></a> }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                </tr>
                            }
                            @if (!Model.Expenses.Any(e => !e.IsDeleted))
                            { <tr><td colspan="6" class="text-center text-muted py-3">@L["No expenses added yet."]</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Documents -->
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-paperclip mr-2"></i>@L["Documents"]</h3>
                    <div class="card-tools">
                        <button class="btn btn-sm btn-info" data-toggle="collapse" data-target="#uploadForm">
                            <i class="fas fa-upload mr-1"></i>@L["Upload"]
                        </button>
                    </div>
                </div>
                <div id="uploadForm" class="collapse">
                    <div class="card-body border-bottom">
                        <form asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tripId" value="@Model.Id">
                            <div class="row align-items-end">
                                <div class="col-md-5 form-group mb-0">
                                    <label>@L["Document Type"]</label>
                                    <select name="documentType" class="form-control form-control-sm">
                                        <option>LR (Lorry Receipt)</option><option>Invoice</option>
                                        <option>POD (Proof of Delivery)</option><option>Toll Receipt</option>
                                        <option>Fuel Bill</option><option>Weighment Slip</option><option>Other</option>
                                    </select>
                                </div>
                                <div class="col-md-5 form-group mb-0">
                                    <label>@L["File"]</label>
                                    <input type="file" name="file" class="form-control-file pt-1" accept=".pdf,.jpg,.jpeg,.png">
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-info btn-sm w-100">@L["Upload"]</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead><tr><th style="width:80px;">@L["Actions"]</th><th>@L["Type"]</th><th>@L["File"]</th><th>@L["Size"]</th><th>@L["Uploaded"]</th></tr></thead>
                        <tbody>
                            @foreach (var doc in Model.Documents.Where(d => !d.IsDeleted))
                            {
                                <tr>
                                    <td>
                                        <a href="@doc.FilePath" target="_blank" class="btn btn-xs btn-info" title="View"><i class="fas fa-eye"></i></a>
                                        <a href="@doc.FilePath" download class="btn btn-xs btn-secondary" title="Download"><i class="fas fa-download"></i></a>
                                    </td>
                                    <td><span class="badge badge-info">@doc.DocumentType</span></td>
                                    <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@doc.FileName</td>
                                    <td>@(doc.FileSizeBytes / 1024) KB</td>
                                    <td>@doc.CreatedAt.ToString("dd MMM")</td>
                                </tr>
                            }
                            @if (!Model.Documents.Any(d => !d.IsDeleted))
                            { <tr><td colspan="5" class="text-center text-muted py-3">@L["No documents uploaded."]</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div></section>
