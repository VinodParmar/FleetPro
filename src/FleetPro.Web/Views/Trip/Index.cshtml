@* ══════════════════ Views/Trip/Index.cshtml ══════════════════ *@
@model List<FleetPro.Models.Entities.Trip>
@{
    ViewData["Title"] = "Trips";
    bool isHi = ViewData["Lang"]?.ToString() == "hi";
}

<div class="content-header"><div class="container-fluid">
    <div class="row mb-2">
        <div class="col-sm-6">
            <h1 class="m-0">@(isHi ? "यात्रा प्रबंधन" : "Trip Management")
                <a asp-action="Create" class="btn btn-primary btn-sm ml-2"><i class="fas fa-plus mr-1"></i>@(isHi ? "नई यात्रा" : "New Trip")</a>
            </h1>
        </div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i></a></li>
                <li class="breadcrumb-item active">@(isHi ? "यात्रा प्रबंधन" : "Trip Management")</li>
            </ol>
        </div>
    </div>
</div></div>

<section class="content"><div class="container-fluid">

    <div class="row mb-3">
        <div class="col-md-3"><div class="info-box mb-0"><span class="info-box-icon bg-info"><i class="fas fa-route"></i></span><div class="info-box-content"><span class="info-box-text">@(isHi ? "कुल" : "Total")</span><span class="info-box-number">@Model.Count</span></div></div></div>
        <div class="col-md-3"><div class="info-box mb-0"><span class="info-box-icon bg-warning"><i class="fas fa-spinner"></i></span><div class="info-box-content"><span class="info-box-text">@(isHi ? "प्रगति में" : "In Progress")</span><span class="info-box-number">@Model.Count(t => t.Status == FleetPro.Models.Entities.TripStatus.InProgress)</span></div></div></div>
        <div class="col-md-3"><div class="info-box mb-0"><span class="info-box-icon bg-success"><i class="fas fa-check-double"></i></span><div class="info-box-content"><span class="info-box-text">@(isHi ? "पूर्ण" : "Completed")</span><span class="info-box-number">@Model.Count(t => t.Status == FleetPro.Models.Entities.TripStatus.Completed)</span></div></div></div>
        <div class="col-md-3"><div class="info-box mb-0"><span class="info-box-icon bg-primary"><i class="fas fa-rupee-sign"></i></span><div class="info-box-content"><span class="info-box-text">@(isHi ? "कुल आय" : "Total Revenue")</span><span class="info-box-number">₹@Model.Sum(t => t.Revenue).ToString("N0")</span></div></div></div>
    </div>

    <div class="card">
        <div class="card-header">
            <form method="get" class="form-inline flex-wrap" style="gap:6px;">
                <input name="from" type="date" value="@Context.Request.Query["from"]" class="form-control form-control-sm">
                <input name="to"   type="date" value="@Context.Request.Query["to"]"   class="form-control form-control-sm">
                <select name="status" class="form-control form-control-sm">
                    <option value="">@(isHi ? "सभी स्थिति" : "All Status")</option>
                    @foreach (var s in Enum.GetValues<FleetPro.Models.Entities.TripStatus>())
                    { <option value="@s" selected="@(ViewBag.StatusFilter?.ToString() == s.ToString() ? "selected" : null)">@s</option> }
                </select>
                <input name="search" value="@Context.Request.Query["search"]" class="form-control form-control-sm" placeholder="@(isHi ? "यात्रा# / स्थान…" : "Trip# / location…")">
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fas fa-filter mr-1"></i>@(isHi ? "फ़िल्टर" : "Filter")</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">@(isHi ? "साफ़ करें" : "Clear")</a>
                <a asp-controller="Report" asp-action="ExportTripsExcel" class="btn btn-sm btn-success ml-auto"><i class="fas fa-file-excel mr-1"></i>@(isHi ? "Excel निर्यात" : "Export Excel")</a>
            </form>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:110px;">@(isHi ? "कार्रवाई" : "Actions")</th>
                        <th>@(isHi ? "यात्रा #" : "Trip #")</th><th>@(isHi ? "से" : "From")</th><th>@(isHi ? "तक" : "To")</th><th>@(isHi ? "चालक" : "Driver")</th><th>@(isHi ? "ट्रक" : "Truck")</th>
                        <th>@(isHi ? "शुरू" : "Start")</th><th>@(isHi ? "समाप्त" : "End")</th><th>@(isHi ? "आय" : "Revenue")</th><th>@(isHi ? "व्यय" : "Expenses")</th><th>@(isHi ? "लाभ" : "Profit")</th><th>@(isHi ? "स्थिति" : "Status")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        var profit = t.Revenue - t.TotalExpenses;
                        <tr>
                            <td class="action-btn">
                                <a asp-action="Details" asp-route-id="@t.Id" class="btn btn-xs btn-info" title="View"><i class="fas fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-xs btn-warning" title="Edit"><i class="fas fa-edit"></i></a>
                                <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-xs btn-danger" data-confirm="@(isHi ? "यात्रा " + t.TripNumber + " हटाएं?" : "Delete trip " + t.TripNumber + "?")" title="Delete"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                            <td><strong>@t.TripNumber</strong></td>
                            <td style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@t.FromLocation</td>
                            <td style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@t.ToLocation</td>
                            <td>@t.Driver?.FullName</td>
                            <td>@t.Truck?.NumberPlate</td>
                            <td>@t.StartDate.ToString("dd/MM/yy")</td>
                            <td>@(t.EndDate?.ToString("dd/MM/yy") ?? "—")</td>
                            <td class="text-success font-weight-bold">₹@t.Revenue.ToString("N0")</td>
                            <td><a asp-controller="Expense" asp-action="Index" asp-route-tripId="@t.Id" class="text-danger font-weight-bold" title="@(isHi ? "व्यय देखें" : "View expenses")">₹@t.TotalExpenses.ToString("N0")</a></td>
                            <td class="@(profit >= 0 ? "text-primary" : "text-danger") font-weight-bold">₹@profit.ToString("N0")</td>
                            <td>
                                @switch (t.Status)
                                {
                                    case FleetPro.Models.Entities.TripStatus.Completed:  <span class="badge badge-success">@(isHi ? "पूर्ण" : "Completed")</span>  break;
                                    case FleetPro.Models.Entities.TripStatus.InProgress: <span class="badge badge-warning">@(isHi ? "प्रगति में" : "In Progress")</span> break;
                                    case FleetPro.Models.Entities.TripStatus.Scheduled:  <span class="badge badge-info">@(isHi ? "निर्धारित" : "Scheduled")</span>    break;
                                    case FleetPro.Models.Entities.TripStatus.Cancelled:  <span class="badge badge-danger">@(isHi ? "रद्द" : "Cancelled")</span>   break;
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="12" class="text-center text-muted py-4">@(isHi ? "कोई यात्रा नहीं मिली।" : "No trips found.") <a asp-action="Create">@(isHi ? "पहली यात्रा बनाएं →" : "Create first trip →")</a></td></tr>
                    }
                </tbody>
                @if (Model.Any())
                {
                    <tfoot class="bg-light font-weight-bold">
                        <tr>
                            <td colspan="8" class="text-right">@(isHi ? "कुल:" : "Totals:")</td>
                            <td class="text-success">₹@Model.Sum(t => t.Revenue).ToString("N0")</td>
                            <td class="text-danger">₹@Model.Sum(t => t.TotalExpenses).ToString("N0")</td>
                            <td class="text-primary">₹@Model.Sum(t => t.NetProfit).ToString("N0")</td>
                            <td></td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div></section>
