@* ══════════════════ Views/User/Create.cshtml ══════════════════ *@
@model FleetPro.Models.ViewModels.UserViewModel
@{ ViewData["Title"] = Model.Id == 0 ? "Add User" : "Edit User"; bool isCreate = Model.Id == 0; }

<div class="content-header"><div class="container-fluid">
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0">@ViewData["Title"]</h1></div>
        <div class="col-sm-6"><ol class="breadcrumb float-sm-right">
            <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol></div>
    </div>
</div></div>

<section class="content"><div class="container-fluid">
<form asp-action="@(isCreate ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row">
        <div class="col-md-7">
            <div class="card">
                <div class="card-header bg-info text-white"><h3 class="card-title"><i class="fas fa-user mr-2"></i>User Details</h3></div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label asp-for="FullName" class="font-weight-bold">Full Name *</label>
                            <input asp-for="FullName" class="form-control">
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="Email" class="font-weight-bold">Email *</label>
                            @if (!isCreate)
                            {
                                <input asp-for="Email" type="email" class="form-control" readonly>
                            }
                            else
                            {
                                <input asp-for="Email" type="email" class="form-control">
                            }
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="Phone">Phone</label>
                            <input asp-for="Phone" class="form-control" placeholder="+91 98765 43210">
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="Status">Status</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<FleetPro.Models.Entities.UserStatus>()" class="form-control"></select>
                        </div>
                        @if (User.IsInRole("SuperAdmin") && ViewBag.Tenants != null)
                        {
                            <div class="col-md-12 form-group">
                                <label asp-for="TenantId" class="font-weight-bold">Tenant</label>
                                <select asp-for="TenantId" asp-items="ViewBag.Tenants" class="form-control">
                                    <option value="">— Global (Super Admin) —</option>
                                </select>
                            </div>
                        }
                        <div class="col-md-6 form-group">
                            <label asp-for="RoleId" class="font-weight-bold">Role *</label>
                            <select asp-for="RoleId" asp-items="ViewBag.Roles" class="form-control">
                                <option value="">— Select Role —</option>
                            </select>
                            <span asp-validation-for="RoleId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="Password" class="font-weight-bold">@(isCreate ? "Password *" : "New Password (leave blank to keep)")</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="@(isCreate ? "Min 8 characters" : "Leave blank to keep current")">
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card">
                <div class="card-header"><h3 class="card-title"><i class="fas fa-info-circle mr-2"></i>Role Permissions</h3></div>
                <div class="card-body">
                    <table class="table table-sm table-borderless mb-0" style="font-size:12px;">
                        <thead><tr><th>Role</th><th>Access Level</th></tr></thead>
                        <tbody>
                            <tr><td><span class="badge badge-dark">Super Admin</span></td><td>Full system access, all tenants</td></tr>
                            <tr><td><span class="badge badge-primary">Tenant Admin</span></td><td>Full access within their tenant</td></tr>
                            <tr><td><span class="badge badge-info">Data Entry</span></td><td>View, Create, Edit — no Delete</td></tr>
                            <tr><td><span class="badge badge-secondary">Viewer</span></td><td>Read-only access</td></tr>
                        </tbody>
                    </table>
                    <hr>
                    <p class="text-muted small mb-0">
                        <i class="fas fa-info-circle mr-1"></i>After creating the user, you can set fine-grained permissions using the <strong>Permissions</strong> button in the user list.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="text-right mb-3">
        <a asp-action="Index" class="btn btn-secondary mr-2"><i class="fas fa-times mr-1"></i>Cancel</a>
        <button type="submit" class="btn btn-info"><i class="fas fa-save mr-1"></i>@(isCreate ? "Create User" : "Save Changes")</button>
    </div>
</form>
</div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
