@* ══════════════════ Views/Truck/Index.cshtml ══════════════════ *@
@model List<FleetPro.Models.Entities.Truck>
@{
    ViewData["Title"] = L["Trucks"].Value;
    string ExpiryClass(DateTime? d) => d == null ? "" : (d < DateTime.Today ? "expiry-bad" : d < DateTime.Today.AddDays(30) ? "expiry-warn" : "expiry-ok");
    string ExpiryLabel(DateTime? d) => d == null ? "—" : (d < DateTime.Today ? L["EXPIRED"].Value : ((d.Value - DateTime.Today).Days + "d"));
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">@L["Trucks"]</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i></a></li>
                    <li class="breadcrumb-item active">@L["Trucks"]</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content"><div class="container-fluid">

    <!-- Summary boxes -->
    <div class="row mb-3">
        <div class="col-md-3"><div class="info-box mb-0"><span class="info-box-icon bg-info"><i class="fas fa-truck"></i></span><div class="info-box-content"><span class="info-box-text">@L["Total"]</span><span class="info-box-number">@Model.Count</span></div></div></div>
        <div class="col-md-3"><div class="info-box mb-0"><span class="info-box-icon bg-success"><i class="fas fa-check"></i></span><div class="info-box-content"><span class="info-box-text">@L["Active"]</span><span class="info-box-number">@Model.Count(t => t.Status == FleetPro.Models.Entities.TruckStatus.Active)</span></div></div></div>
        <div class="col-md-3"><div class="info-box mb-0"><span class="info-box-icon bg-warning"><i class="fas fa-wrench"></i></span><div class="info-box-content"><span class="info-box-text">@L["Maintenance"]</span><span class="info-box-number">@Model.Count(t => t.Status == FleetPro.Models.Entities.TruckStatus.InMaintenance)</span></div></div></div>
        <div class="col-md-3"><div class="info-box mb-0"><span class="info-box-icon bg-danger"><i class="fas fa-exclamation"></i></span><div class="info-box-content"><span class="info-box-text">@L["Expiry Alerts"]</span><span class="info-box-number">@Model.Count(t => (t.InsuranceExpiry < DateTime.Today.AddDays(30)) || (t.FitnessExpiry < DateTime.Today.AddDays(30)))</span></div></div></div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
            <form method="get" class="form-inline" style="gap:6px;">
                <select name="status" class="form-control form-control-sm" onchange="this.form.submit()">
                    <option value="">@L["All Status"]</option>
                    @foreach (var s in Enum.GetValues<FleetPro.Models.Entities.TruckStatus>())
                    { <option value="@s" selected="@(ViewBag.StatusFilter?.ToString() == s.ToString() ? "selected" : null)">@s</option> }
                </select>
                <input name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="@L["Search plate / model…"]">
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fas fa-search"></i></button>
            </form>
            <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus mr-1"></i>@L["Add Truck"]</a>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:100px;">@L["Actions"]</th>
                        <th>@L["Plate"]</th><th>@L["Model"]</th><th>@L["Year"]</th>
                        @if (User.IsInRole("SuperAdmin")) { <th>@L["Company"]</th> }
                        <th>@L["Fitness Expiry"]</th><th>@L["Insurance Expiry"]</th><th>@L["Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="action-btn">
                                <a asp-action="Edit" asp-route-eid="@Ids.Protect(t.Id)" class="btn btn-xs btn-warning" title="Edit"><i class="fas fa-edit"></i></a>
                                <form asp-action="Delete" asp-route-eid="@Ids.Protect(t.Id)" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-xs btn-danger" data-confirm="@L["Delete truck {0}?", t.NumberPlate]" title="Delete"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                            <td><strong>@t.NumberPlate</strong></td>
                            <td>@t.Model</td>
                            <td>@t.ManufacturingYear</td>
                            @if (User.IsInRole("SuperAdmin")) { <td>@t.Tenant?.CompanyName</td> }
                            <td class="@ExpiryClass(t.FitnessExpiry)">
                                <i class="fas @(t.FitnessExpiry < DateTime.Today.AddDays(30) ? "fa-exclamation-triangle" : "fa-check-circle") mr-1"></i>
                                @(t.FitnessExpiry?.ToString("dd MMM yyyy") ?? "—") <small>(@ExpiryLabel(t.FitnessExpiry))</small>
                            </td>
                            <td class="@ExpiryClass(t.InsuranceExpiry)">
                                <i class="fas @(t.InsuranceExpiry < DateTime.Today.AddDays(30) ? "fa-exclamation-triangle" : "fa-check-circle") mr-1"></i>
                                @(t.InsuranceExpiry?.ToString("dd MMM yyyy") ?? "—") <small>(@ExpiryLabel(t.InsuranceExpiry))</small>
                            </td>
                            <td>
                                @switch (t.Status)
                                {
                                    case FleetPro.Models.Entities.TruckStatus.Active: <span class="badge badge-success">@L["Active"]</span> break;
                                    case FleetPro.Models.Entities.TruckStatus.InMaintenance: <span class="badge badge-warning">@L["Maintenance"]</span> break;
                                    case FleetPro.Models.Entities.TruckStatus.Inactive: <span class="badge badge-secondary">@L["Inactive"]</span> break;
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">@L["No trucks found."]</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div></section>
