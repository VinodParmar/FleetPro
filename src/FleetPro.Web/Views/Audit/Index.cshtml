@* ══════════════════ Views/Audit/Index.cshtml ══════════════════ *@
@model List<FleetPro.Models.Entities.AuditLog>
@{
    ViewData["Title"] = L["Audit Logs"].Value;
    var modules = ViewBag.Modules as List<string> ?? new();
    var moduleFilter = ViewBag.ModuleFilter as string;
    var fromDate = ViewBag.FromDate as DateTime?;
    var toDate = ViewBag.ToDate as DateTime?;
}

<div class="content-header"><div class="container-fluid">
    <div class="row mb-2">
        <div class="col-sm-6">
            <h1 class="m-0"><i class="fas fa-history mr-2"></i>@L["Audit Logs"]</h1>
        </div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i></a></li>
                <li class="breadcrumb-item active">@L["Audit Logs"]</li>
            </ol>
        </div>
    </div>
</div></div>

<section class="content"><div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <form method="get" class="form-inline" style="gap:8px;">
                <select name="module" class="form-control form-control-sm">
                    <option value="">@L["All Modules"]</option>
                    @foreach (var m in modules)
                    {
                        <option value="@m" selected="@(moduleFilter == m ? "selected" : null)">@m</option>
                    }
                </select>
                <input type="date" name="from" value="@fromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" placeholder="From">
                <input type="date" name="to" value="@toDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" placeholder="To">
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fas fa-search"></i> @L["Filter"]</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">@L["Clear"]</a>
            </form>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-striped mb-0">
                <thead class="thead-dark">
                    <tr>
                        <th style="width:150px;">@L["Date/Time"]</th>
                        <th style="width:100px;">@L["Module"]</th>
                        <th style="width:80px;">@L["Action"]</th>
                        <th>@L["Description"]</th>
                        <th style="width:120px;">@L["IP Address"]</th>
                        <th style="width:80px;">@L["User"]</th>
                        <th style="width:60px;">@L["Details"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        var actionColor = log.Action switch {
                            "Create" => "success",
                            "Update" => "warning",
                            "Delete" => "danger",
                            "Login" => "info",
                            "Logout" => "secondary",
                            _ => "primary"
                        };
                        <tr>
                            <td class="small">@log.CreatedAt.ToString("dd MMM yyyy HH:mm:ss")</td>
                            <td><span class="badge badge-primary">@log.Module</span></td>
                            <td><span class="badge badge-@actionColor">@log.Action</span></td>
                            <td class="small" style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@log.Description">@log.Description</td>
                            <td class="small text-muted">@log.IpAddress</td>
                            <td class="small">@(log.UserId?.ToString() ?? "—")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(log.OldValues) || !string.IsNullOrEmpty(log.NewValues))
                                {
                                    <button type="button" class="btn btn-xs btn-outline-info" data-toggle="modal" data-target="#detailModal-@log.Id" title="@L["View Details"]">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">@L["No audit logs found."]</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer small text-muted">
            @L["Showing"] @Model.Count @L["records"]
        </div>
    </div>
</div></section>

<!-- Detail Modals -->
@foreach (var log in Model.Where(l => !string.IsNullOrEmpty(l.OldValues) || !string.IsNullOrEmpty(l.NewValues)))
{
    <div class="modal fade" id="detailModal-@log.Id" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title"><i class="fas fa-history mr-2"></i>@log.Module - @log.Action</h5>
                    <button type="button" class="close text-white" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-danger"><i class="fas fa-minus-circle mr-1"></i>@L["Old Values"]</h6>
                            <pre class="bg-light p-2 small" style="max-height:300px;overflow:auto;">@(log.OldValues ?? "—")</pre>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-success"><i class="fas fa-plus-circle mr-1"></i>@L["New Values"]</h6>
                            <pre class="bg-light p-2 small" style="max-height:300px;overflow:auto;">@(log.NewValues ?? "—")</pre>
                        </div>
                    </div>
                    <hr>
                    <div class="row small text-muted">
                        <div class="col-4"><strong>@L["Date"]:</strong> @log.CreatedAt.ToString("dd MMM yyyy HH:mm:ss")</div>
                        <div class="col-4"><strong>@L["User ID"]:</strong> @(log.UserId?.ToString() ?? "—")</div>
                        <div class="col-4"><strong>@L["IP"]:</strong> @log.IpAddress</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">@L["Close"]</button>
                </div>
            </div>
        </div>
    </div>
}
